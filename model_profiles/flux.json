      {"key": "clip_name2", "label": "Text Encoder 2 (T5XXL)", "asset_type": "text_encoder", "family": "flux", "name_pattern": "t5xxl"},
      {"key": "vae_model", "label": "VAE", "asset_type": "vae", "family": "flux", "name_pattern": "(^|/)ae\\.safetensors$"}
